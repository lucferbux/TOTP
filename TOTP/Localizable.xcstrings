    "A fixed prefix is added before the code when copying" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Kopieren wird ein fester Präfix vor den Code gesetzt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se añade un prefijo fijo antes del código al copiarlo"
