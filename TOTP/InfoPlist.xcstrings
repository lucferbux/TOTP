    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TOTP verwendet die Kamera, um den QR-Code zu scannen, der beim Einrichten der Zwei-Faktor-Authentifizierung angezeigt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TOTP uses the camera to scan the QR code shown when you set up two-factor authentication."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TOTP usa la cámara para escanear el código QR que aparece al configurar la verificación en dos pasos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TOTP utilise l’appareil photo pour scanner le code QR affiché lors de la configuration de l’authentification à deux facteurs."
          }
        }
      }
    },
