# Metadata for the App Store listing. Binaries are still archived and uploaded by the
# `release-totp` skill with xcodebuild — these lanes only touch text and screenshots.
#
# Nothing here submits for review: every lane leaves the version in Prepare for Submission.

# This project ships no analytics; don't send any from its tooling either.
opt_out_usage
# fastlane/README.md is written by hand — don't let a lane run replace it with the generated one.
skip_docs

default_platform(:ios)

# The App Store Connect API key. Never store the .p8 in the repo.
def asc_key
  key_id    = ENV["ASC_KEY_ID"]
  issuer_id = ENV["ASC_ISSUER_ID"]
  key_path  = File.expand_path(ENV["ASC_KEY_PATH"] || "~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")

  UI.user_error!("Set ASC_KEY_ID, ASC_ISSUER_ID and ASC_KEY_PATH — see fastlane/README.md") if key_id.nil? || issuer_id.nil?
  UI.user_error!("No API key at #{key_path}") unless File.exist?(key_path)

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_path,
    duration: 1200,
    in_house: false
  )
end

# MARKETING_VERSION straight from the project. (fastlane's get_version_number can't parse the
# Xcode 27 pbxproj format — issue #30223 — so read it directly.)
def marketing_version
  pbxproj = File.read("../TOTP.xcodeproj/project.pbxproj")
  version = pbxproj[/MARKETING_VERSION = ([0-9.]+);/, 1]
  UI.user_error!("Couldn't read MARKETING_VERSION from the project") if version.nil?
  version
end

# Shared deliver options. `platform` is "ios" or "osx" — deliver has no "macos".
def deliver_options(platform:, metadata_path:, screenshots_path:, skip_screenshots:)
  {
    api_key: asc_key,
    platform: platform,
    app_version: marketing_version,   # the version record still has to be told which version it is
    metadata_path: metadata_path,
    screenshots_path: screenshots_path,
    skip_binary_upload: true,       # binaries come from xcodebuild, see .claude/skills/release-totp
    skip_screenshots: skip_screenshots,
    skip_app_version_update: false,
    submit_for_review: false,       # never auto-submit; a human reviews the draft
    automatic_release: false,
    force: true,                    # no interactive HTML preview
    precheck_include_in_app_purchases: false,
    run_precheck_before_submit: false
  }
end

lane :metadata do
  push_metadata(skip_screenshots: false)
end

lane :metadata_text do
  push_metadata(skip_screenshots: true)
end

# Screenshots only. Also the way round fastlane #20538: deliver's metadata step crashes with
# "No data" when an app has no App Store review detail yet, which it can't create without a
# contact phone number.
lane :screenshots_upload do
  UI.message("Uploading iOS screenshots…")
  upload_to_app_store(
    api_key: asc_key,
    platform: "ios",
    app_version: marketing_version,
    # Still needed with skip_metadata: deliver validates this folder's layout either way.
    metadata_path: "./fastlane/metadata/ios",
    screenshots_path: "./fastlane/screenshots",
    skip_binary_upload: true,
    skip_metadata: true,
    skip_screenshots: false,
    submit_for_review: false,
    force: true,
    overwrite_screenshots: true,
    run_precheck_before_submit: false
  )

  UI.message("Uploading macOS screenshots…")
  upload_to_app_store(
    api_key: asc_key,
    platform: "osx",
    app_version: marketing_version,
    metadata_path: "./fastlane/metadata/mac",
    screenshots_path: "./fastlane/screenshots_mac",
    skip_binary_upload: true,
    skip_metadata: true,
    skip_screenshots: false,
    submit_for_review: false,
    force: true,
    overwrite_screenshots: true,
    run_precheck_before_submit: false
  )
end

def push_metadata(skip_screenshots:)
  UI.message("Pushing iOS metadata…")
  upload_to_app_store(**deliver_options(
    platform: "ios",
    metadata_path: "./fastlane/metadata/ios",
    screenshots_path: "./fastlane/screenshots",
    skip_screenshots: skip_screenshots
  ))

  UI.message("Pushing macOS metadata…")
  upload_to_app_store(**deliver_options(
    platform: "osx",
    metadata_path: "./fastlane/metadata/mac",
    screenshots_path: "./fastlane/screenshots_mac",
    skip_screenshots: skip_screenshots
  ))

  UI.success("Both versions updated as drafts. Review them in App Store Connect before submitting.")
end

# Apple's own checks (trademarks, placeholder text, broken URLs) before anything is pushed.
lane :precheck_all do
  # include_in_app_purchases: precheck can't read IAPs with an API key.
  check_app_store_metadata(api_key: asc_key, platform: "ios", default_rule_level: :warn, include_in_app_purchases: false)
  check_app_store_metadata(api_key: asc_key, platform: "osx", default_rule_level: :warn, include_in_app_purchases: false)
end

# Only the App Review notes of the current version, on both platforms. `metadata` pushes the whole listing.
desc "Push the App Review notes"
lane :review_notes do
  require "net/http"
  key_id = ENV["ASC_KEY_ID"] || "KMSBU6865L"
  token = Spaceship::ConnectAPI::Token.create(
    key_id: key_id,
    issuer_id: ENV["ASC_ISSUER_ID"] || "69a6de88-17cf-47e3-e053-5b8c7c11a4d1",
    filepath: File.expand_path(ENV["ASC_KEY_PATH"] || "~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  )
  api = lambda do |method, path, body = nil|
    uri = URI("https://api.appstoreconnect.apple.com#{path}")
    request = Net::HTTP.const_get(method).new(uri)
    request["Authorization"] = "Bearer #{token.text}"
    request["Content-Type"] = "application/json"
    request.body = JSON.generate(body) if body
    response = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(request) }
    UI.user_error!("#{method} #{path}: #{response.code} #{response.body}") unless response.code.to_i < 300
    response.body.to_s.empty? ? {} : JSON.parse(response.body)
  end
  { "IOS" => "ios", "MAC_OS" => "mac" }.each do |platform, folder|
    query = "filter%5Bplatform%5D=#{platform}&filter%5BversionString%5D=#{marketing_version}&include=appStoreReviewDetail"
    version = api.call(:Get, "/v1/apps/6742797604/appStoreVersions?#{query}")["data"].first || UI.user_error!("No #{platform} version")
    detail = version.dig("relationships", "appStoreReviewDetail", "data", "id") || UI.user_error!("No #{platform} review detail")
    notes = File.read("metadata/#{folder}/review_information/notes.txt").strip
    api.call(:Patch, "/v1/appStoreReviewDetails/#{detail}", { data: { type: "appStoreReviewDetails", id: detail, attributes: { notes: notes } } })
    UI.success("#{platform}: #{notes.length} characters")
  end
end

# Keep in step with TipJarManager and StoreKit/Tips.storekit.
TIPS = [
  { id: "com.lucferbux.TOTP.tip.small", name: "A Coffee", description: "A small thank you", price: "0.99" },
  { id: "com.lucferbux.TOTP.tip.medium", name: "A Large Coffee", description: "For a long night of fixes", price: "2.99" },
  { id: "com.lucferbux.TOTP.tip.large", name: "A Week of Coffee", description: "For the next big update", price: "4.99" }
].freeze

# Creates the consumable tips, skipping any that exist. Prices are based on Spain, and Apple sets the rest.
desc "Create the tip in-app purchases"
lane :tips do
  require "net/http"
  require "digest"
  key_id = ENV["ASC_KEY_ID"] || "KMSBU6865L"
  token = Spaceship::ConnectAPI::Token.create(
    key_id: key_id,
    issuer_id: ENV["ASC_ISSUER_ID"] || "69a6de88-17cf-47e3-e053-5b8c7c11a4d1",
    filepath: File.expand_path(ENV["ASC_KEY_PATH"] || "~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  )
  api = lambda do |method, path, body = nil|
    uri = URI("https://api.appstoreconnect.apple.com#{path}")
    request = Net::HTTP.const_get(method).new(uri)
    request["Authorization"] = "Bearer #{token.text}"
    request["Content-Type"] = "application/json"
    request.body = JSON.generate(body) if body
    response = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(request) }
    UI.user_error!("#{method} #{path}: #{response.code} #{response.body}") unless response.code.to_i < 300
    response.body.to_s.empty? ? {} : JSON.parse(response.body)
  end
  app_id = "6742797604"
  screenshot = "screenshots_review/tips.png"
  existing = api.call(:Get, "/v1/apps/#{app_id}/inAppPurchasesV2?limit=50")["data"].map { |i| i["attributes"]["productId"] }
  territories = api.call(:Get, "/v1/territories?limit=200")["data"].map { |t| { type: "territories", id: t["id"] } }

  TIPS.each do |tip|
    if existing.include?(tip[:id])
      UI.message("#{tip[:id]} already exists")
      next
    end
    purchase_id = api.call(:Post, "/v2/inAppPurchases", { data: { type: "inAppPurchases",
      attributes: { name: tip[:name], productId: tip[:id], inAppPurchaseType: "CONSUMABLE",
                    reviewNote: "Voluntary tip to the developer. It unlocks nothing. Settings > Buy Me a Coffee." },
      relationships: { app: { data: { type: "apps", id: app_id } } } } })["data"]["id"]
    purchase = { type: "inAppPurchases", id: purchase_id }

    api.call(:Post, "/v1/inAppPurchaseLocalizations", { data: { type: "inAppPurchaseLocalizations",
      attributes: { locale: "en-US", name: tip[:name], description: tip[:description] },
      relationships: { inAppPurchaseV2: { data: purchase } } } })

    api.call(:Post, "/v1/inAppPurchaseAvailabilities", { data: { type: "inAppPurchaseAvailabilities",
      attributes: { availableInNewTerritories: true },
      relationships: { inAppPurchase: { data: purchase }, availableTerritories: { data: territories } } } })

    points = api.call(:Get, "/v2/inAppPurchases/#{purchase_id}/pricePoints?filter%5Bterritory%5D=ESP&limit=200")["data"]
    point = points.find { |p| p["attributes"]["customerPrice"] == tip[:price] } || UI.user_error!("No price point #{tip[:price]}")
    api.call(:Post, "/v1/inAppPurchasePriceSchedules", {
      data: { type: "inAppPurchasePriceSchedules", relationships: {
        inAppPurchase: { data: purchase },
        baseTerritory: { data: { type: "territories", id: "ESP" } },
        manualPrices: { data: [{ type: "inAppPurchasePrices", id: "${price}" }] } } },
      included: [{ type: "inAppPurchasePrices", id: "${price}", attributes: { startDate: nil },
                   relationships: { inAppPurchaseV2: { data: purchase },
                                    inAppPurchasePricePoint: { data: { type: "inAppPurchasePricePoints", id: point["id"] } } } }] })

    bytes = File.binread(screenshot)
    reservation = api.call(:Post, "/v1/inAppPurchaseAppStoreReviewScreenshots", { data: { type: "inAppPurchaseAppStoreReviewScreenshots",
      attributes: { fileName: "tips.png", fileSize: bytes.bytesize },
      relationships: { inAppPurchaseV2: { data: purchase } } } })["data"]
    reservation["attributes"]["uploadOperations"].each do |operation|
      uri = URI(operation["url"])
      request = Net::HTTP.const_get(operation["method"].capitalize).new(uri)
      operation["requestHeaders"].each { |header| request[header["name"]] = header["value"] }
      request.body = bytes.byteslice(operation["offset"], operation["length"])
      response = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(request) }
      UI.user_error!("Screenshot upload: #{response.code}") unless response.code.to_i < 300
    end
    api.call(:Patch, "/v1/inAppPurchaseAppStoreReviewScreenshots/#{reservation["id"]}", { data: {
      type: "inAppPurchaseAppStoreReviewScreenshots", id: reservation["id"],
      attributes: { uploaded: true, sourceFileChecksum: Digest::MD5.hexdigest(bytes) } } })
    UI.success("Created #{tip[:id]} at #{tip[:price]} EUR")
  end
end

# Regenerates App Store screenshots from the UI tests.
lane :screenshots do
  sh("../scripts/export-screenshots.sh")
end
