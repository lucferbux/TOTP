{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(xcodebuild -list:*)",
      "Bash(xcodebuild -version)",
      "Bash(xcodebuild build:*)",
      "Bash(xcodebuild test:*)",
      "Bash(xcodebuild clean:*)",
      "Bash(xcodebuild -showBuildSettings:*)",
      "Bash(xcrun simctl list:*)",
      "Bash(xcrun simctl boot:*)",
      "Bash(xcrun simctl shutdown:*)",
      "Bash(xcrun xctrace list:*)",
      "Bash(xcbeautify:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift --version)",
      "Bash(plutil:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash list:*)"
    ]
  }
}
