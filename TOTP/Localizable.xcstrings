    "TOTP Password" : {
      "localizations" : {},
      "shouldTranslate" : true
    },
    "TOTP Password has no ads, no tracking and no subscription. If it saves you time, a coffee helps keep it that way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TOTP Password hat keine Werbung, kein Tracking und kein Abo. Wenn dir die App Zeit spart, hilft ein Kaffee, dass es so bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TOTP Password no tiene anuncios, ni rastreo, ni suscripción. Si te ahorra tiempo, un café ayuda a que siga así."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TOTP Password n’a ni publicité, ni pistage, ni abonnement. Si l’app vous fait gagner du temps, un café aide à ce que ça dure."
          }
        }
      }
    },
    "TOTP Support" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TOTP-Support"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soporte de TOTP"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistance TOTP"
          }
        }
      }
    },
    "TOTP doesn't collect any data. Your accounts stay on your devices and in your own iCloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TOTP sammelt keine Daten. Deine Accounts bleiben auf deinen Geräten und in deiner eigenen iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TOTP no recopila ningún dato. Tus cuentas se quedan en tus dispositivos y en tu propio iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TOTP ne collecte aucune donnée. Vos comptes restent sur vos appareils et dans votre propre iCloud."
          }
        }
      }
    },
    "TOTP is locked and this device can't authenticate right now." : {
