    "Accounts sync through your private iCloud database. Secrets stay encrypted with a key shared only through your iCloud Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accounts werden über deine private iCloud-Datenbank synchronisiert. Die Schlüssel bleiben verschlüsselt – mit einem Schlüssel, der nur über deinen iCloud-Schlüsselbund geteilt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas se sincronizan con tu base de datos privada de iCloud. Los secretos siguen cifrados con una clave que solo se comparte a través de tu llavero de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes se synchronisent via votre base de données iCloud privée. Les secrets restent chiffrés avec une clé partagée uniquement par votre trousseau iCloud."
          }
        }
      }
    },
