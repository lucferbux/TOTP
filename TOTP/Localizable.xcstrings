    "A one-time, voluntary payment handled by Apple. It unlocks nothing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine einmalige, freiwillige Zahlung über Apple. Sie schaltet nichts frei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pago único y voluntario gestionado por Apple. No desbloquea nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un paiement unique et facultatif géré par Apple. Il ne débloque rien."
          }
        }
      }
    },
