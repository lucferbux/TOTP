    "%lld account(s) couldn't be decrypted on this device. They're kept untouched; signing in to the same iCloud account should restore access." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Account konnte auf diesem Gerät nicht entschlüsselt werden. Er bleibt unverändert; mit demselben iCloud-Account angemeldet, solltest du wieder Zugriff haben."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Accounts konnten auf diesem Gerät nicht entschlüsselt werden. Sie bleiben unverändert; mit demselben iCloud-Account angemeldet, solltest du wieder Zugriff haben."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld account couldn't be decrypted on this device. It's kept untouched; signing in to the same iCloud account should restore access."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld accounts couldn't be decrypted on this device. They're kept untouched; signing in to the same iCloud account should restore access."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "No se ha podido descifrar %lld cuenta en este dispositivo. Se conserva intacta; al iniciar sesión con la misma cuenta de iCloud deberías recuperar el acceso."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "No se han podido descifrar %lld cuentas en este dispositivo. Se conservan intactas; al iniciar sesión con la misma cuenta de iCloud deberías recuperar el acceso."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld compte n’a pas pu être déchiffré sur cet appareil. Il est conservé intact ; en vous connectant au même compte iCloud, vous devriez retrouver l’accès."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld comptes n’ont pas pu être déchiffrés sur cet appareil. Ils sont conservés intacts ; en vous connectant au même compte iCloud, vous devriez retrouver l’accès."
                }
              }
            }
          }
        }
      }
    },
